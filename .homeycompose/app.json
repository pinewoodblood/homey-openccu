{
  "id": "io.github.pinewoodblood.openccu",
  "version": "0.1.11",
  "compatibility": ">=12.9.0",
  "sdk": 3,
  "name": {
    "en": "OpenCCU Local Enhanced",
    "de": "OpenCCU Local Enhanced"
  },
  "description": {
    "en": "Enhanced local Homematic IP integration through CCU/OpenCCU",
    "de": "Erweiterte lokale Homematic-IP-Integration über CCU/OpenCCU"
  },
  "tags": {
    "en": [
      "OpenCCU",
      "Homematic IP",
      "HmIP",
      "local"
    ],
    "de": [
      "OpenCCU",
      "Homematic IP",
      "HmIP",
      "lokal"
    ]
  },
  "category": [
    "tools",
    "appliances"
  ],
  "permissions": [],
  "api": {
    "getDiscovery": {
      "method": "get",
      "path": "/discovery"
    },
    "getDiagnostics": {
      "method": "get",
      "path": "/diagnostics"
    },
    "getMemoryDiagnostics": {
      "method": "get",
      "path": "/diagnostics/memory"
    },
    "getHeatingTargets": {
      "method": "get",
      "path": "/heating/targets"
    },
    "readHeatingSchedule": {
      "method": "post",
      "path": "/heating/read"
    },
    "saveHeatingSchedule": {
      "method": "post",
      "path": "/heating/save"
    }
  },
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "brandColor": "#192c6e",
  "author": {
    "name": "pinewoodblood (fork)"
  },
  "bugs": {
    "url": "https://github.com/pinewoodblood/homey-openccu/issues"
  },
  "source": "https://github.com/pinewoodblood/homey-openccu",
  "homepage": "https://github.com/pinewoodblood/homey-openccu",
  "support": "https://github.com/pinewoodblood/homey-openccu/issues",
  "contributors": {
